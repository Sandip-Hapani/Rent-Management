# ---- Core ----
# Public base URL used in emails and Origin checks (no trailing slash)
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://rent:rent@localhost:5433/rent?schema=public
# Direct (non-pooled) connection used for migrations. Locally the same as DATABASE_URL.
DIRECT_URL=postgresql://rent:rent@localhost:5433/rent?schema=public
# Used only by integration tests (a separate, disposable database)
TEST_DATABASE_URL=postgresql://rent:rent@localhost:5433/rent_test?schema=public
# Shared secret for POST /api/cron/tick (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me-change-me-change-me-change-me
APP_TIMEZONE=Europe/Berlin

# ---- Email (SMTP). Dev: Mailpit from docker-compose (web UI http://localhost:8025) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Apartment Rent <rent@localhost>"

# ---- File storage: "local" (disk), "db" (inside Postgres) or "s3". Default: "db" on Vercel/Netlify/Render, else "local" ----
STORAGE_DRIVER=local
# Directory for local driver (must NOT be inside public/)
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Optional malware scanning via clamd ----
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---- Worker ----
# Set to "false" to disable the in-process cron (e.g. when using an external cron hitting /api/cron/tick)
WORKER_ENABLED=true

# ---- Default administrator (created once during deployment by `npm run build:deploy`) ----
# Leave empty locally (use `npm run create-admin` or the demo seed instead).
# The account is only created if no administrator exists yet; changing these later has no effect.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
# At least 10 characters. Change it after your first sign-in (Profile & security).
INITIAL_ADMIN_PASSWORD=
INITIAL_APARTMENT_NAME=
# Optional, YYYY-MM-DD (defaults to the deployment date)
INITIAL_ADMIN_MOVE_IN=
