# Automatic HTTPS (Let's Encrypt) in front of the app.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 30MB
	}
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
		format console
	}
}
